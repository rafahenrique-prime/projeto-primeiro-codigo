# ============================================================
# .env.example — IGNITE PRIME CRM (ignite-webhook)
# ============================================================
# Copie este arquivo para .env e .env.local e preencha os valores.
#
# REGRAS:
#   - Variáveis com prefixo VITE_ são expostas ao navegador.
#   - Variáveis SEM prefixo VITE_ são server-side only (api/, scripts/).
#   - Token GPTMaker (VITE_GPTMAKER_USER_TOKEN) vai no .env.local, NUNCA no .env.
#   - Sempre sincronizar .env com Vercel antes de git push origin main.
#
# Fonte: docs/DEPLOY.md §3 + grep src/ api/ scripts/
# ============================================================

# ── Supabase (PostgreSQL + Storage) ──────────────────────────
# Usado por: 41+ arquivos em src/ e api/
# Vercel: OBRIGATÓRIO
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# ── GPT Maker (CRM / IA Gabriela) ─────────────────────────────
# Usado por: gptmaker.js, systemHealthService.js, api/auto-photo.js,
#            api/cron-diagnosis.js, api/cron-stuck-check.js, api/gptmaker-credits.js
# Vercel: OBRIGATÓRIO

# Token de API (não expira — diferente do USER_TOKEN)
VITE_GPTMAKER_TOKEN=

# Token de sessão do usuário (expira ~24h, renovar diariamente)
# REGRAS: .env.local APENAS. Nunca committar. Atualizar via view-source.
VITE_GPTMAKER_USER_TOKEN=

# Workspace ID — NUNCA alterar sem validação
VITE_GPTMAKER_WORKSPACE=

# URL base da API GPT Maker (padrão: https://api.gptmaker.ai)
VITE_GPTMAKER_URL=

# Credenciais de login (usadas pelo script token-receiver.js / renovar-token.sh)
# Não aparecem no grep de src/api — consumidas por scripts operacionais.
VITE_GPTMAKER_EMAIL=
VITE_GPTMAKER_PASSWORD=

# ── Groq (LLM fallback — llama-3.3-70b) ──────────────────────
# Usado por: groq.js, ocrService.js, systemHealthService.js,
#            knowledgeParser.js, api/cron-diagnosis.js
# Vercel: OBRIGATÓRIO
VITE_GROQ_API_KEY=

# ── DeepSeek (análise secundária) ─────────────────────────────
# Usado por: deepseek.js, deepseekBalanceService.js
# Vercel: OBRIGATÓRIO
VITE_DEEPSEEK_API_KEY=

# ── Google Drive (Catálogo Rascunho) ──────────────────────────
# Usado por: googleDriveCatalog.js (DraftCatalogPage)
# Vercel: OBRIGATÓRIO (sem isso, DraftCatalogPage some em prod)
VITE_GOOGLE_DRIVE_API_KEY=
VITE_GOOGLE_DRIVE_FOLDER_ID=

# ── Base44 (Cobranças) ────────────────────────────────────────
# Usado por: cobrancasService.js
# Vercel: OBRIGATÓRIO
VITE_BASE44_APP_ID=
VITE_BASE44_API_KEY=

# ── AWS Rekognition (reconhecimento de imagens) ───────────────
# Usado por: awsRekognitionService.js, photoRecognitionService.js
VITE_AWS_ACCESS_KEY=
VITE_AWS_SECRET_KEY=
VITE_AWS_REGION=

# ── OpenRouter (roteador de LLMs alternativo) ─────────────────
# Usado por: groq.js (fallback), ocrService.js
VITE_OPENROUTER_KEY=

# ── Google Vision + OpenAI (reconhecimento de fotos) ──────────
# Usado por: photoRecognitionService.js
# ATENÇÃO: Estas NÃO estão em nenhum .env local — podem estar na Vercel
VITE_GOOGLE_VISION_KEY=
VITE_OPENAI_API_KEY=

# ── Cohere (embeddings para knowledge) ────────────────────────
# Usado por: api/embed-knowledge.js (server-side only — SEM prefixo VITE_)
# Vercel: OBRIGATÓRIO
COHERE_API_KEY=

# ── Telegram (alertas de diagnóstico) ─────────────────────────
# Usado por: api/telegram-alert.js, api/cron-diagnosis.js, api/cron-stuck-check.js
# ATENÇÃO: Server-side only — SEM prefixo VITE_. Só existe na Vercel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Bagy (auditoria da loja) ─────────────────────────────────
# Usado por: api/bagy-audit.js
# Server-side only — SEM prefixo VITE_. Só existe na Vercel.
BAGY_STORE_URL=

# ── Google OAuth (scripts locais) ──────────────────────────────
# Usado por: scripts/fix-drive-permissions.mjs
# ATENÇÃO: SEM prefixo VITE_ (não pode vazar pro navegador)
# Só local — não precisa ir para Vercel
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Build-time (injetadas pelo vite.config.js, não definidas manualmente) ──
# VERCEL           → vira __IS_VERCEL__ (bool)
# VERCEL_GIT_COMMIT_SHA → vira __COMMIT_SHA__ (string)
# Não definir manualmente — são injetadas pela Vercel no build.
